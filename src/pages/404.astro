---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="That page does not exist.">
  <div class="shell">
    <section class="not-found">
      <span class="label">Error 404</span>
      <h1>This page shipped somewhere else.</h1>
      <p>The link is broken, or the page moved while I was refactoring. Both have happened before.</p>
      <div class="hero-actions">
        <a class="primary-pill" href="/">Back home <span class="arrow">→</span></a>
        <a class="gh-link" href="/writing">Read the writing</a>
      </div>
    </section>
  </div>
</Base>
