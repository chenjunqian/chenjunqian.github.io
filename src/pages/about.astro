---
import Base from '../layouts/Base.astro';
import { socials } from '../data/projects';
---

<Base title="About" description="Infrastructure engineer at a global e-commerce marketplace and indie builder in Shanghai. I ship products end to end and write about what it takes.">
  <div class="shell">
    <header class="page-head">
      <span class="eyebrow">About</span>
      <h1>Infrastructure by day,<br />product by night.</h1>
    </header>

    <section class="about-hero">
      <div class="about-portrait">
        <div class="portrait">
          <img src="/images/avatar.webp" alt="Portrait of Junqian Chen" width="360" height="360" />
        </div>
        <div class="facts">
          <div><span>Based in</span><strong>Shanghai, China</strong></div>
          <div><span>Day job</span><strong>Infrastructure · e-commerce marketplace</strong></div>
          <div><span>Working on</span><strong>MovTrak · Trend Catcher</strong></div>
          <div><span>Open to</span><strong>Interesting problems</strong></div>
        </div>
      </div>

      <div class="about-copy">
        <p class="lede">
          I'm Junqian Chen. I make software for a living and more software for fun, and the line
          between the two has never been particularly clear.
        </p>
        <p>
          At a global e-commerce marketplace I work on infrastructure — the systems that sit under
          everything else. It is a job that rewards patience and a tolerance for ambiguity, and it
          has shaped how I build my own products: small surfaces, boring dependencies, and a strong
          bias toward shipping the simplest thing that survives contact with reality.
        </p>
        <p>
          Outside of work I build small tools for the web, for iOS, and for AI agents —
          <a class="text-link" href="/projects">see the projects <span class="arrow">→</span></a>
        </p>

        <div class="hero-actions">
          <a class="primary-pill" href={`mailto:${socials.email}`}>Say hello <span class="arrow">↗</span></a>
          <a class="gh-link" href={socials.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="contact-cta">
        <div>
          <span class="label">Get in touch</span>
          <h2>Building something interesting?</h2>
          <p>I'm always happy to talk about infrastructure, product, or an idea that is still a sketch on a napkin.</p>
        </div>
        <a class="primary-pill" href={`mailto:${socials.email}`}>chenjunqian0810@foxmail.com <span class="arrow">↗</span></a>
      </div>
    </section>
  </div>
</Base>
