---
import Base from '../layouts/Base.astro';
import { socials } from '../data/projects';

const stack = [
  { group: 'Languages', items: ['Go', 'TypeScript', 'Python', 'Swift', 'SQL'] },
  { group: 'Product', items: ['React', 'Vite', 'SwiftUI', 'Cloudflare Workers'] },
  { group: 'Infrastructure', items: ['PostgreSQL', 'D1 / SQLite', 'AWS', 'Docker', 'pgvector'] },
  { group: 'AI', items: ['LLM orchestration', 'DeepSeek', 'Gemini', 'Agent skills / MCP'] },
];

const principles = [
  {
    title: 'Boring infrastructure',
    body: 'The best infrastructure is the kind nobody thinks about. I optimise for cost per request, deploy time and the number of things that can page me at 3am.',
  },
  {
    title: 'Ship the whole thing',
    body: 'Product, frontend, backend, deployment, support. Owning the full path makes the tradeoffs obvious — and it is the only way small products stay coherent.',
  },
  {
    title: 'Write it down',
    body: 'Every project here taught me something that did not fit in a commit message. Writing is how I make sure I only learn it once.',
  },
];

const now = [
  'Polishing MovTrak ahead of its App Store release',
  'Building this site — Astro, no tracking, no comments',
  'Reading more papers than is strictly practical',
  'Based in Shanghai, working in UTC+8',
];
---

<Base title="About" description="Infrastructure engineer at eBay and indie builder in Shanghai. I ship products end to end and write about what it takes.">
  <div class="shell">
    <header class="page-head">
      <span class="eyebrow">About</span>
      <h1>Infrastructure by day,<br />product by night.</h1>
    </header>

    <section class="about-hero">
      <div class="about-portrait">
        <div class="portrait">
          <img src="/images/avatar.webp" alt="Portrait of Junqian Chen" width="360" height="360" />
        </div>
        <div class="facts">
          <div><span>Based in</span><strong>Shanghai, China</strong></div>
          <div><span>Day job</span><strong>Infrastructure · eBay</strong></div>
          <div><span>Working on</span><strong>MovTrak · Trend Catcher</strong></div>
          <div><span>Open to</span><strong>Interesting problems</strong></div>
        </div>
      </div>

      <div class="about-copy">
        <p class="lede">
          I'm Junqian Chen. I make software for a living and more software for fun, and the line
          between the two has never been particularly clear.
        </p>
        <p>
          At eBay I work on infrastructure — the systems that sit under everything else. It is a
          job that rewards patience and a tolerance for ambiguity, and it has shaped how I build my
          own products: small surfaces, boring dependencies, and a strong bias toward shipping the
          simplest thing that survives contact with reality.
        </p>
        <p>
          Outside of work I build for the web, for iOS, and increasingly for AI agents. Porkast
          turns podcast subscriptions into keyword feeds and personal RSS. Trend Catcher reads the
          internet so indie developers do not have to. MovTrak turns an iPhone into a camera that
          follows a climber. JD Matcher reads job listings against a resume and vetoes the ones that
          waste your time.
        </p>
        <p>
          I'm not interested in building the next platform. I'm interested in making small,
          durable things that a specific person reaches for every day — and in writing down the
          parts that were harder than expected.
        </p>

        <div class="hero-actions">
          <a class="primary-pill" href={`mailto:${socials.email}`}>Say hello <span class="arrow">↗</span></a>
          <a class="gh-link" href={socials.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <span class="label">How I work</span>
          <h2>Three habits</h2>
        </div>
      </div>
      <div class="principle-grid">
        {principles.map((principle, index) => (
          <article class="principle">
            <span class="index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <span class="label">Toolbox</span>
          <h2>Stack</h2>
          <p>The tools that survived. No list is permanent, but these have earned their keep.</p>
        </div>
      </div>
      <div class="stack-groups">
        {stack.map((group) => (
          <div class="stack-group">
            <h3>{group.group}</h3>
            <div class="stack-items">
              {group.items.map((item) => <span class="chip">{item}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <span class="label">Now</span>
          <h2>What I'm up to</h2>
          <p>Updated when it changes. Currently — {new Date().toLocaleString('en-US', { month: 'long', year: 'numeric' })}.</p>
        </div>
        <a class="text-link" href="/projects">See the projects <span class="arrow">→</span></a>
      </div>
      <ul class="now-list">
        {now.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="section">
      <div class="contact-cta">
        <div>
          <span class="label">Get in touch</span>
          <h2>Building something interesting?</h2>
          <p>I'm always happy to talk about infrastructure, product, or an idea that is still a sketch on a napkin.</p>
        </div>
        <a class="primary-pill" href={`mailto:${socials.email}`}>chenjunqian0810@foxmail.com <span class="arrow">↗</span></a>
      </div>
    </section>
  </div>
</Base>
