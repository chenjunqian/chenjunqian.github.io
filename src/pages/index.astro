---
import Base from '../layouts/Base.astro';
import FeatureCard from '../components/FeatureCard.astro';
import RecentList from '../components/RecentList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getPosts } from '../lib/posts';
import { projects } from '../data/projects';

const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const railProjects = projects.filter((project) => project.featured).slice(0, 2);
---

<Base>
  <div class="shell">
    <section class="hero">
      <div class="hero-copy">
        <span class="eyebrow"><span class="status-dot"></span>Shanghai · infra engineer · indie builder</span>
        <h1>Hi, This is Junqian.</h1>
        <p class="hero-lede">
        By day I'm as a infra engineer, try to build something useful things at night.
        </p>
      </div>

      <aside class="hero-aside" aria-label="Quick facts">
        <div class="hero-stats">
          <div class="hero-stat">
            04
            <span>Products shipped</span>
          </div>
          <div class="hero-stat">
            12<span>Years building</span>
          </div>
        </div>
      </aside>
    </section>

    <section class="home-grid" aria-label="Latest work and writing">
      <div class="rail">
        {railProjects.map((project) => <ProjectCard project={project} variant="rail" />)}
      </div>

      {featured ? (
        <FeatureCard post={featured} />
      ) : (
        <article class="feature">
          <div class="feature-body">
            <span class="tag-pill">Notes</span>
            <h2>The first note is being written.</h2>
            <p class="excerpt">
              No posts yet. Subscribe to the RSS feed and you will get it the moment it lands.
            </p>
            <a class="read-more" href="/rss.xml">Subscribe via RSS <span class="arrow">→</span></a>
          </div>
        </article>
      )}

      <RecentList posts={posts} />
    </section>

    <section class="section" aria-labelledby="projects-heading">
      <div class="section-head">
        <div>
          <span class="label">Selected work</span>
          <h2 id="projects-heading">Things I've shipped</h2>
          <p>Four products, built end to end: product, design, backend, deployment. All still running.</p>
        </div>
        <a class="text-link" href="/projects">All projects <span class="arrow">→</span></a>
      </div>

      <div class="project-list">
        {projects.map((project, index) => <ProjectRow project={project} index={index} />)}
      </div>
    </section>
  </div>
</Base>
