---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Writing" description="Notes on shipping products, AI agents and infrastructure — written between deploys.">
  <div class="shell">
    <header class="page-head">
      <span class="eyebrow">Writing</span>
      <h1>Notes from the build and thought.</h1>
    </header>

    <section class="archive">
      {posts.length > 0 ? (
        posts.map((post) => (
          <article class="archive-item">
            <div class="archive-date">{formatDate(post.data.date)}</div>
            <div>
              <h2><a href={`/writing/${post.id}`}>{post.data.title}</a></h2>
              <p class="desc">{post.data.description}</p>
            </div>
            <div class="tag">{post.data.tag}</div>
          </article>
        ))
      ) : (
        <div class="empty-state">
          <p>The first piece is still being written. Subscribe via <a class="text-link" href="/rss.xml">RSS</a> and you will get it as soon as it ships.</p>
        </div>
      )}
    </section>
  </div>
</Base>
