---
import Base from '../../layouts/Base.astro';
import { projects, socials } from '../../data/projects';

const intro = 'Four products, kept alive in the gaps between a full-time job. Each one started as a personal annoyance, then grew into something other people use.';
---

<Base title="Projects" description={intro}>
  <div class="shell">
    <header class="page-head">
      <span class="eyebrow">Projects</span>
      <h1>Built nights and weekends.</h1>
      <p>
        {intro} They are listed newest-first by how much of my life they currently consume.
        Every link goes to the live thing — no case-study theatre.
      </p>
    </header>

    <div class="project-spread">
      {projects.map((project) => (
        <section id={project.slug} aria-labelledby={`${project.slug}-title`}>
          <div class="project-card large">
            <div class="project-visual" style={`--tint-a:${project.tintA};--tint-b:${project.tintB};`}>
              <span class="project-icon">
                <img src={project.icon} alt={`${project.name} icon`} loading="lazy" />
              </span>
            </div>

            <div class="project-body">
              <span class="project-kicker">{project.kicker} · {project.year} · {project.status}</span>
              <h3 id={`${project.slug}-title`}>{project.name}</h3>
              <p>{project.description}</p>

              <ul class="feature-list">
                {project.features.map((feature) => <li>{feature}</li>)}
              </ul>

              <div class="project-foot">
                {project.stack.map((tech) => <span class="chip">{tech}</span>)}
              </div>

              <div class="project-links">
                {project.links.map((link) => (
                  <a class="primary-pill" href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label} <span class="arrow">↗</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>

    <section class="section">
      <div class="section-head">
        <div>
          <span class="label">Elsewhere</span>
          <h2>Smaller experiments</h2>
          <p>Dots, tools and half-finished repos that did not deserve a section of their own.</p>
        </div>
      </div>
      <div class="project-list">
        <a class="project-row" href="https://github.com/chenjunqian/dotfiles" target="_blank" rel="noopener noreferrer">
          <span class="index">01</span>
          <span class="name">dotfiles</span>
          <span class="desc">Shell, Neovim and terminal setup, tuned on NixOS</span>
          <span class="go">↗</span>
        </a>
        <a class="project-row" href="https://github.com/chenjunqian/go-markitdown" target="_blank" rel="noopener noreferrer">
          <span class="index">02</span>
          <span class="name">go-markitdown</span>
          <span class="desc">Convert office documents to Markdown in Go</span>
          <span class="go">↗</span>
        </a>
        <a class="project-row" href={socials.github} target="_blank" rel="noopener noreferrer">
          <span class="index">03</span>
          <span class="name">Everything else</span>
          <span class="desc">40 public repositories and counting</span>
          <span class="go">↗</span>
        </a>
      </div>
    </section>
  </div>
</Base>
