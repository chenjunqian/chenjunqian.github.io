---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';

const intro = 'Four products, kept alive in the gaps between a full-time job. Each one started as a personal annoyance, then grew into something other people use.';
---

<Base title="Projects" description={intro}>
  <div class="shell">
    <header class="page-head">
      <span class="eyebrow">Projects</span>
      <h1>Built nights and weekends.</h1>
    </header>

    <div class="project-spread">
      {projects.map((project) => (
        <section id={project.slug} aria-labelledby={`${project.slug}-title`}>
          <div class="project-card large">
            <div class="project-visual" style={`--tint-a:${project.tintA};--tint-b:${project.tintB};`}>
              <span class="project-icon">
                <img src={project.icon} alt={`${project.name} icon`} loading="lazy" />
              </span>
            </div>

            <div class="project-body">
              <span class="project-kicker">{project.kicker} · {project.year} · {project.status}</span>
              <h3 id={`${project.slug}-title`}>{project.name}</h3>
              <p>{project.description}</p>

              <ul class="feature-list">
                {project.features.map((feature) => <li>{feature}</li>)}
              </ul>

              <div class="project-foot">
                {project.stack.map((tech) => <span class="chip">{tech}</span>)}
              </div>

              <div class="project-links">
                {project.links.map((link) => (
                  <a class="primary-pill" href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label} <span class="arrow">↗</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>
