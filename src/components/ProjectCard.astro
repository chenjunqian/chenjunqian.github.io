---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  variant?: 'rail' | 'default' | 'large';
}

const { project, variant = 'default' } = Astro.props;
const primary = project.links[0];
---

<article class:list={['project-card', variant === 'rail' && 'rail', variant === 'large' && 'large']}>
  <div
    class="project-visual"
    style={`--tint-a:${project.tintA};--tint-b:${project.tintB};`}
  >
    <span class="project-icon">
      <img src={project.icon} alt={`${project.name} icon`} loading="lazy" />
    </span>
  </div>

  <div class="project-body">
    <span class="project-kicker">{project.kicker} · {project.status}</span>
    <h3><a href={`/projects#${project.slug}`}>{project.name}</a></h3>
    <p>{project.description}</p>

    {variant !== 'rail' && (
      <ul class="feature-list">
        {project.features.map((feature) => <li>{feature}</li>)}
      </ul>
    )}

    <div class="project-foot">
      {project.stack.slice(0, variant === 'rail' ? 2 : 4).map((tech) => (
        <span class="chip">{tech}</span>
      ))}
      {variant === 'rail' ? (
        <a class="text-link" href={`/projects#${project.slug}`}>View project <span class="arrow">→</span></a>
      ) : (
        <a class="text-link" href={primary.href} target="_blank" rel="noopener noreferrer">
          {primary.label} <span class="arrow">↗</span>
        </a>
      )}
    </div>
  </div>
</article>
