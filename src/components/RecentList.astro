---
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  limit?: number;
}

const { posts, limit = 5 } = Astro.props;
const items = posts.slice(0, limit);
---

<aside class="recent">
  <div class="recent-head">
    <span class="label">Recent writings</span>
    <a href="/writing" aria-label="All writing">→</a>
  </div>

  {items.length > 0 ? (
    <div class="recent-list">
      {items.map((post) => (
        <a class="recent-item" href={`/writing/${post.id}`}>
          <span class="recent-thumb">
            <img src={post.data.cover} alt="" loading="lazy" />
          </span>
          <span>
            <span class="recent-title">{post.data.title}</span>
            <span class="recent-author">{post.data.author}</span>
          </span>
        </a>
      ))}
    </div>
  ) : (
    <p class="recent-empty">Nothing published yet. The first note is being written — subscribe via <a class="text-link" href="/rss.xml">RSS</a> to catch it.</p>
  )}

  <p class="recent-note">Occasional notes on shipping small products and infra that stays "boring".</p>
</aside>
